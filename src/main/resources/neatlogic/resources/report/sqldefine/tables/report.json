{
  "moduleId": "report",
  "name": "report",
  "label": "报表模版表",
  "description": "报表模版表 可用于报表相关的启用状态筛选、时间维度统计等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "主键，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(100)",
      "description": "名称。"
    },
    {
      "name": "type",
      "type": "varchar(100)",
      "description": "类型，已建立普通索引，适合用于过滤、关联或排序查询。"
    },
    {
      "name": "sql",
      "type": "longtext",
      "description": "sql配置。"
    },
    {
      "name": "condition",
      "type": "longtext",
      "description": "条件模板。"
    },
    {
      "name": "content",
      "type": "longtext",
      "description": "内容模板。"
    },
    {
      "name": "is_active",
      "type": "tinyint(1)",
      "description": "是否激活。"
    },
    {
      "name": "visit_count",
      "type": "int",
      "description": "使用次数。"
    },
    {
      "name": "fcu",
      "type": "varchar(100)",
      "description": "创建人。"
    },
    {
      "name": "lcu",
      "type": "varchar(100)",
      "description": "修改人。"
    },
    {
      "name": "fcd",
      "type": "timestamp(3)",
      "description": "创建时间。"
    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
      "description": "修改时间。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "idx_type",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "type"
      ],
      "description": "普通索引，覆盖 type 字段，适合用于过滤、关联或排序查询。"
    }
  ]
}
